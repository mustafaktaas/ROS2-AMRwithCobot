<?xml version = "1.0" ?>
<robot
  name="ford">
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.0231426932087026 3.10400617153928E-06 0.144438929576695"
        rpy="0 0 0" />
      <mass
        value="235.817427828256" />
      <inertia
        ixx="26.1484940787354"
        ixy="-2.15026343437473E-05"
        ixz="-0.2502921428179"
        iyy="22.9421887279596"
        iyz="5.1103599373048E-06"
        izz="39.2802249676799" />
    </inertial>

  </link>
   <link name="base_footprint">
  </link>
  <joint name="base_footprint_joint" type="fixed">
	<origin xyz="0.25125 0 0" rpy="0 0 0" />
	<parent link="base_footprint"/>
	<child link="base_link"/>
  </joint>

   <link name="imu_link">
  </link>
  <joint name="imu_joint" type="fixed">
	<origin xyz="0.02 -0.2 0" rpy="0 0 0" />
	<parent link="base_link"/>
	<child link="imu_link"/>
  </joint>

  <link
    name="frontlidar">
    <inertial>
      <origin
        xyz="3.96242181061046E-06 0.0297127391537713 -0.000648809548592366"
        rpy="0 0 0" />
      <mass
        value="0.367833721247089" />
      <inertia
        ixx="0.000205756604787201"
        ixy="2.78900753044071E-08"
        ixz="4.74805380670418E-08"
        iyy="0.000127405862881745"
        iyz="1.04061737415867E-06"
        izz="0.000200365232614641" />
    </inertial>
  </link>
  <joint
    name="lidar_h"
    type="fixed">
    <origin
      xyz="0.4125 0 0"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="frontlidar" />
    <axis
      xyz="0 0 0" />
  </joint>

<link
    name="obstaclelidar">
</link>

  <joint
    name="obslidar_h"
    type="fixed">
    <origin
      xyz="0.5125 0 0.048000000000001"
      rpy="3.141592653589793238 0 0" />
    <parent
      link="base_link" />
    <child

      link="obstaclelidar" />
    <axis
      xyz="0 0 0" />
  </joint>

 <gazebo reference="frontlidar">
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>1</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <!-- Noise parameters based on published spec for Hokuyo laser
               achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
               stddev of 0.01m will put 99.7% of samples within 0.03m of the true
               reading. -->
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="hokuyo_node" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>frontlidar</frameName>
      </plugin>
    </sensor>
  </gazebo>

<gazebo reference="obstaclelidar">
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>1</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-1.570796</min_angle>
            <max_angle>1.570796</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>5.7</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <!-- Noise parameters based on published spec for Hokuyo laser
               achieving "+-30mm" accuracy at range < 10m.  A mean of 0.0m and
               stddev of 0.01m will put 99.7% of samples within 0.03m of the true

               reading. -->
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="hokuyo_node" filename="libgazebo_ros_laser.so">
        <topicName>/scan_obstacle</topicName>
        <frameName>obstaclelidar</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <legacyMode>false</legacyMode>
      <alwaysOn>true</alwaysOn>
      <updateRate>10</updateRate>
      <leftJoint>r_l_h</leftJoint>
      <rightJoint>r_r_h</rightJoint>
      <wheelSeparation>0.4</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>
      <torque>500</torque>
      <wheelTorque>500</wheelTorque>
      <publishWheelTF>true</publishWheelTF>
     <publishWheelJointState>true</publishWheelJointState>
      <wheelAcceleration>5.2</wheelAcceleration>
      <commandTopic>raw_cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
    </plugin>
  </gazebo>
</robot>
