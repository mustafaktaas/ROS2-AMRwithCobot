    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>       
          <cylinder length="0.08" radius="0.125"/>       
      </geometry>
    </collision>
  </link>


  <joint
    name="r_l_h"
    type="continuous">
    <origin
      xyz="0 0.28 0.1"
      rpy="3.14159265358979 1.32303231890829 3.14159265358979" />
    <parent
      link="base_footprint" />
    <child
      link="rear_left" />
    <axis
      xyz="0 1 0" />
  </joint>



</robot>

