<?xml version = "1.0" ?>
<robot
  name="zeus">
  <link name="base_link"> </link>

  <link name="base_footprint"></link>

  <joint name="base_footprint_joint" type="fixed">
	<origin xyz="0.34 -0.02 0" rpy="0 0 0" />
	<parent link="base_footprint"/>
	<child link="base_link"/>
  </joint>

   <link name="imu_link">
  </link>
  <joint name="imu_joint" type="fixed">
	<origin xyz="0.22 -0.425 0" rpy="0 0 0" />
	<parent link="base_link"/>
	<child link="imu_link"/>
  </joint>


  <link name="frontlidar"> </link>
  <joint
    name="fr_lidar_h"
    type="fixed">
    <origin
      xyz="0.5395 -0.42 0"
      rpy="0 0 -0.7853" />
    <parent
      link="base_link" />
    <child
      link="frontlidar" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link name="frontlidar_top"> </link>
  <joint
    name="fr_lidar_h_t"
    type="fixed">
    <origin
      xyz="0.475931 -0.348431 0.9"
      rpy="0 0 -0.770398" />
    <parent
      link="base_link" />
    <child
      link="frontlidar_top" />
    <axis
      xyz="0 0 1" />
  </joint>

  <link name="rearlidar"> </link>
  <joint
    name="rr_lidar_h"
    type="fixed">
    <origin
      xyz="-0.5396 0.42 0"
      rpy="0 0 2.3561" />
    <parent
      link="base_link" />
    <child
      link="rearlidar" />
    <axis
      xyz="0 0 0" />
  </joint>

  <link name="rearlidar_top"> </link>
  <joint
    name="rr_lidar_h_t"
    type="fixed">
    <origin
      xyz="-0.535931 0.348431 0.90"
      rpy="0 0 2.341194" />
    <parent
      link="base_link" />
    <child
      link="rearlidar_top" />
    <axis
      xyz="0 0 1" />
  </joint>

  <link name="camera_link"> </link>
  
  <joint
    name="camera_link_h"
    type="fixed">
    <origin
      xyz="-0.4696 0 0.10"
      rpy="0 -1.57 0" />
    <parent
      link="base_link" />
    <child
      link="camera_link" />
    <axis
      xyz="0 0 0" />
  </joint>

<link
    name="rear_right">
    <inertial>
      <origin
        xyz="1.11022302462516E-16 -0.0249999999999997 -5.55111512312578E-17"
        rpy="0 0 0" />
      <mass
        value="4.20287370285305" />
      <inertia
        ixx="0.0114776102831476"
        ixy="-2.83870510583311E-17"
        ixz="-8.67361737988404E-19"
        iyy="0.0212040231901065"
        iyz="1.29509923971745E-17"
        izz="0.0114776102831476" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sdv_description/urdf/archive/meshes/rear_right.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <cylinder length="0.08" radius="0.125"/>           
      </geometry>
    </collision>
  </link>


  <joint
    name="motor_wheel1"
    type="continuous">
    <origin
      xyz="0 -0.28 0.0999999999999992"
      rpy="3.14159265358979 -1.23330957383996 -3.14159265358979" />
    <parent
      link="base_footprint" />
    <child
      link="rear_right" />
    <axis
      xyz="0 1 0" />
  </joint>


  <link
    name="rear_left">
    <inertial>
      <origin
        xyz="0 0.025 -1.38777878078145E-17"
        rpy="0 0 0" />
      <mass
        value="4.20287370285305" />
      <inertia
        ixx="0.0114776102831476"
        ixy="-7.11326584524164E-22"
        ixz="8.67361737988404E-19"
        iyy="0.0212040231901065"
        iyz="2.55381220766474E-19"
        izz="0.0114776102831476" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://sdv_description/urdf/archive/meshes/rear_left.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.898039215686275 0.917647058823529 0.929411764705882 1" />
